# MedSatya — local dev env. Copy to .env (git-ignored) and fill in.
# In-platform (Databricks Apps) these come from the app's resources / OAuth — do NOT ship a PAT.

# --- Data source (parametrized; never hardcode in code) ---
MEDSATYA_CATALOG=databricks_virtue_foundation_dataset_dais_2026
MEDSATYA_SCHEMA=virtue_foundation_dataset
MEDSATYA_FACILITIES_TABLE=facilities

# --- SQL Warehouse ---
# In-platform: provided as app resource -> DATABRICKS_WAREHOUSE_ID (OAuth, no token).
DATABRICKS_WAREHOUSE_ID=344b0522dfa0bbb2

# --- Local dev auth (PAT via SQL Statement Execution REST API) ---
DATABRICKS_HOST=https://dbc-ad43c802-45af.cloud.databricks.com
DATABRICKS_TOKEN=

# --- Persistence (Delta) ---
MEDSATYA_STORE_CATALOG=
MEDSATYA_STORE_SCHEMA=
MEDSATYA_STORE_TABLE=medsatya_saved

# --- AI layer (Databricks) ---
# Embeddings (Layer 1, semantic care-need match) + FM clarify (Layer 2). Defaults in code.
MEDSATYA_EMBEDDING_ENDPOINT=databricks-gte-large-en
MEDSATYA_CLARIFY_ENDPOINT=databricks-meta-llama-3-1-8b-instruct
MEDSATYA_MODEL_SERVING_ENDPOINT=

# --- OpenAI (conversational triage agent + realtime voice) — put the REAL key in .env, never here ---
# Server-side only; the key is never exposed to the browser. In-platform: inject as a Databricks App
# secret env var. Empty key => app degrades gracefully to the Databricks embeddings + clarify chain.
OPENAI_API_KEY=
OPENAI_MODEL=                 # default gpt-4o-mini (cheap, function calling)
OPENAI_TRANSCRIBE_MODEL=      # default gpt-4o-mini-transcribe
OPENAI_REALTIME_MODEL=        # default gpt-realtime-mini (WebRTC voice)

# --- Feedback email hook (Delta-first; empty key => email disabled, still stored to Delta) ---
MEDSATYA_FEEDBACK_EMAIL_KEY=
MEDSATYA_FEEDBACK_EMAIL_FROM=
MEDSATYA_FEEDBACK_EMAIL_TO=ullmann@fel.zcu.cz
